          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Workoutes no puede guardar entrenamientos en Salud. En el iPhone, abre Salud → tu perfil → Apps → Workoutes y permite escribir entrenamientos. Después, intenta iniciar de nuevo."
          }
        }
      }
